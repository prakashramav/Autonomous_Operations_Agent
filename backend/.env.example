# LLM Configuration (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Backend Settings
PROJECT_NAME="EnterpriseOps Agent"
PORT=8000
ENVIRONMENT=development

# Database & Cache
DATABASE_URL=postgresql+asyncpg://enterpriseops:enterpriseops_pwd@localhost:5432/enterpriseops_db
REDIS_URL=redis://localhost:6379/0
