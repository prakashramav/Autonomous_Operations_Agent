# ==============================================================================
# EnterpriseOps-Agent Environment Variables Template
# ==============================================================================

# LLM Configuration (Anthropic Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Backend Settings
PROJECT_NAME="EnterpriseOps Agent"
PORT=8000
ENVIRONMENT=development

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000

# Persistence & Memory (PostgreSQL + pgvector)
POSTGRES_USER=enterpriseops
POSTGRES_PASSWORD=enterpriseops_pwd
POSTGRES_DB=enterpriseops_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://enterpriseops:enterpriseops_pwd@localhost:5432/enterpriseops_db

# Short-term Memory (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# MCP Integration Keys (Phases 4-5)
# Google Workspace (Gmail, Drive, Calendar)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# LangSmith Observability (Optional, Phase 6)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=enterprise-ops-agent
