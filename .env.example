# ==============================================================================
# EnterpriseOps-Agent Environment Variables Template
# ==============================================================================

# LLM Configuration (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Backend Settings
PROJECT_NAME="EnterpriseOps Agent"
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=*,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,https://autonomous-operations-agent.vercel.app

# Frontend Settings
NEXT_PUBLIC_API_URL=https://autonomous-operations-agent.vercel.app

# Persistence & Memory (PostgreSQL + pgvector)
POSTGRES_USER=enterpriseops
POSTGRES_PASSWORD=enterpriseops_pwd
POSTGRES_DB=enterpriseops_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://enterpriseops:enterpriseops_pwd@localhost:5432/enterpriseops_db

# Short-term Memory (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# MCP Integration Keys (Phases 4-5)
# Google Workspace (Gmail, Drive, Calendar)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# LangSmith / Agent Observability (Optional, Phase 6)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=enterprise-ops-agent
